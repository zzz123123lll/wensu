      "pack_id": "common-markdown",
      "pack_version": "1.0.0",
      "category": "language",
      "engine": "deterministic",
      "scope": "master",
      "severity": "warning",
      "enabled": true,
      "params": {},
      "source": {"type": "experience", "title": "写作常识：标点使用"},
      "fix_mode": "exact_patch"
