{
  "pack_id": "common-markdown",
  "pack_version": "1.0.0",
  "name": "通用基础规则",
  "description": "Block/Markdown、链接、引用、基本语言与证据完整性（系统技术约束，不依赖外部平台）。",
  "rules": [
    {
      "id": "common.heading.order",
      "name": "标题层级顺序",
      "description": "标题不得跳级",
      "pack_id": "common-markdown",
      "pack_version": "1.0.0",
      "category": "format",
      "engine": "deterministic",
      "scope": "master",
      "severity": "error",
      "enabled": true,
      "params": {"max_skip": 1},
      "source": {"type": "system", "title": "引擎技术约束：标题层级一致性"},
      "fix_mode": "candidate"
    },
    {
      "id": "common.heading.empty",
      "name": "空标题",
      "description": "标题下没有文字内容",
      "pack_id": "common-markdown",
      "pack_version": "1.0.0",
      "category": "format",
      "engine": "deterministic",
      "scope": "master",
      "severity": "warning",
      "enabled": true,
      "params": {},
      "source": {"type": "system", "title": "引擎技术约束：结构完整性"},
      "fix_mode": "exact_patch"
    },
    {
      "id": "common.heading.duplicate-title",
      "name": "重复主标题",
      "description": "两处 H1 标题文字相同",
      "pack_id": "common-markdown",
      "pack_version": "1.0.0",
      "category": "format",
      "engine": "deterministic",
      "scope": "master",
      "severity": "warning",
      "enabled": true,
      "params": {},
      "source": {"type": "system", "title": "引擎技术约束：结构一致性"},
      "fix_mode": "advisory"
    },
    {
      "id": "common.markdown.unsafe-url",
      "name": "不安全链接",
      "description": "链接协议仅允许 http/https",
      "pack_id": "common-markdown",
      "pack_version": "1.0.0",
      "category": "format",
      "engine": "deterministic",
      "scope": "master",
      "severity": "error",
      "enabled": true,
      "params": {},
      "source": {"type": "system", "title": "安全约束：URL scheme 白名单"},
      "fix_mode": "exact_patch"
    },
    {
      "id": "common.markdown.image-alt",
      "name": "图片替代文本",
      "description": "图片必须有 alt 文字",
      "pack_id": "common-markdown",
      "pack_version": "1.0.0",
      "category": "format",
      "engine": "deterministic",
      "scope": "master",
      "severity": "warning",
      "enabled": true,
      "params": {},
      "source": {"type": "system", "title": "Markdown 渲染约束"},
      "fix_mode": "advisory"
