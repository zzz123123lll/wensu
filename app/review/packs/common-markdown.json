      "pack_id": "common-markdown",
      "pack_version": "1.0.0",
      "category": "language",
      "engine": "deterministic",
      "scope": "master",
      "severity": "suggestion",
      "enabled": true,
      "params": {"max_len": 100},
      "source": {"type": "experience", "title": "编辑经验：长句拆短"},
      "fix_mode": "advisory"
